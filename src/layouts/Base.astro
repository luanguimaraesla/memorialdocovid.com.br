---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = 'Memorial do Covid',
  description =
    'Um ponto para cada vida perdida para a Covid-19 no Brasil, segundo o total nacional do Ministério da Saúde.',
  image = '/previas/memorial.png',
  imageAlt = 'Memorial do Covid: uma vida, um ponto',
} = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4SW9W1M6L0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4SW9W1M6L0');

      // Button clicks. The capture phase reads each toggle's state before its own handler flips it.
      document.addEventListener('click', function (event) {
        var button = event.target.closest && event.target.closest('button');
        if (!button) return;
        var pressed = button.getAttribute('aria-pressed') === 'true';
        var statement = button.closest('[id^="declaracao-"]');
        var item = statement ? { item_id: statement.id.slice('declaracao-'.length) } : {};
        if (button.id === 'btn-start') gtag('event', 'start_journey');
        else if (button.id === 'btn-play') gtag('event', 'toggle_play', { action: pressed ? 'pause' : 'play' });
        else if (button.id === 'btn-mode') gtag('event', 'toggle_mode', { mode: pressed ? 'guided' : 'continuous' });
        else if (button.id === 'btn-share') gtag('event', 'share', { location: 'controls' });
        else if (button.hasAttribute('data-share-closing')) gtag('event', 'share', { location: 'closing' });
        else if (button.classList.contains('declaracao__compartilhar')) gtag('event', 'share', Object.assign({ location: 'statement' }, item));
        else if (button.classList.contains('declaracao__read')) gtag('event', 'read_more', item);
        else if (button.hasAttribute('data-audio-toggle')) {
          gtag('event', 'toggle_audio', { action: pressed ? 'unmute' : button.hasAttribute('data-silent') ? 'play' : 'mute' });
        }
      }, true);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Memorial do Covid" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
