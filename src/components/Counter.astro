---
---

<div class="reference-line" data-reference-line aria-hidden="true"></div>

<aside class="counter" data-counter data-idle aria-label="Vidas perdidas e tempo de pandemia">
  <div class="counter__summary">
    <div>
      <p class="counter__label">Vidas perdidas</p>
      <strong class="counter__lives" data-counter-lives>…</strong>
    </div>
    <div>
      <p class="counter__label">Tempo de pandemia</p>
      <strong class="counter__days" data-counter-days>…</strong>
    </div>
  </div>
</aside>

<div class="playback" data-scroll-control data-playback hidden>
  <div class="playback__controls" role="group" aria-label="Controles de rolagem automática">
    <button class="playback__button playback__play" id="btn-play" type="button" aria-label="Continuar o percurso" aria-pressed="false" disabled>
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
        <path class="autoscroll-player__icon-play" d="M4.5 2.5v11L13 8z" />
        <path class="autoscroll-player__icon-pause" d="M4 2.5h3v11H4zM9 2.5h3v11H9z" />
      </svg>
      <span data-play-label>Continuar</span>
    </button>
    <button class="playback__button" id="btn-share" type="button" aria-label="Compartilhar o memorial" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
        <path d="M12 15V3M7.5 7.5 12 3l4.5 4.5M5 12v8h14v-8" />
      </svg>
      Compartilhar
    </button>
    <button class="playback__button playback__mode" id="btn-mode" type="button" aria-label="Ativar modo contínuo, sem pausas nos marcos" aria-pressed="false" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
        <path d="M12 12c-3-5-8-5-8 0s5 5 8 0 8-5 8 0-5 5-8 0Z" />
      </svg>
      Sem pausas
    </button>
  </div>
</div>

<p class="sr-only" data-announcer aria-live="polite"></p>
<p class="share-status panel" data-share-status role="status" hidden></p>

<dialog class="share-dialog" id="share-dialog" aria-labelledby="share-title">
  <h2 id="share-title">Compartilhar</h2>
  <label for="share-message">Copie a mensagem e o link para compartilhar:</label>
  <textarea id="share-message" rows="5" readonly></textarea>
  <button class="page-button" id="share-close" type="button">Fechar</button>
</dialog>
