---
import { DOT_RADIUS_PX } from '../config';
import { columnWidth, rowPitch, separatorHeight } from '../lib/layout';

// One light row over one gray row, tiled down each block of dots. A small image is
// rasterized once and repeated, which keeps fast scrolling cheap on phones.
const pitch = rowPitch();
const radius = DOT_RADIUS_PX;
const tile = `<svg xmlns='http://www.w3.org/2000/svg' width='${pitch}' height='${2 * pitch}'>`
  + `<circle cx='${radius}' cy='${radius}' r='${radius}' fill='#e8e4dc'/>`
  + `<circle cx='${radius}' cy='${pitch + radius}' r='${radius}' fill='#cbc7bf'/></svg>`;
const geometry = [
  `--coluna: ${columnWidth()}px`, `--passo: ${pitch}px`, `--separador-altura: ${separatorHeight()}px`,
  `--pontos: url("data:image/svg+xml,${encodeURIComponent(tile)}")`,
].join('; ');
---

<section class="section memorial" aria-label="Uma vida, um ponto" style={geometry}>
  <div class="wrap">
    <p class="aviso-sintetico" data-aviso-sintetico hidden>
      <strong>Declarações sintéticas de exemplo.</strong>
    </p>
  </div>

  <div class="memorial__track" data-track>
    <div class="memorial__dots" data-dots aria-hidden="true"></div>
    <div class="memorial__separators" data-separators aria-hidden="true"></div>
    <div class="memorial__news-markers" data-news-markers aria-hidden="true"></div>
    <div class="memorial__weeks" data-weeks></div>
    <div class="memorial__marks" data-marks></div>
    <div class="memorial__floating" data-floating hidden></div>
  </div>
</section>
